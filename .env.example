# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# Database Configuration (SQLite default for zero-setup local dev)
DATABASE_FILE=./database/godown_stocks.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/godown_stocks

# Timezone (Default: Asia/Kolkata for Rajahmundry, Andhra Pradesh)
TZ=Asia/Kolkata
